{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": ["es2020"],
    "types": ["node"],
    "typeRoots": ["./anchor-program/node_modules/@types"],
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist/demo",
    "rootDir": ".",
    "baseUrl": ".",
    "moduleResolution": "node"
  },
  "include": ["demo/**/*.ts"],
  "exclude": ["node_modules", "anchor-program/target"]
}
